rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'itsniranjan2007@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isDocOwner(data) {
      return isSignedIn() && (
        (data.uid != null && data.uid == request.auth.uid) ||
        (request.auth.token.email != null && data.email != null && data.email == request.auth.token.email) ||
        (request.auth.token.email != null && data.memberEmail != null && data.memberEmail == request.auth.token.email)
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Members collection
    match /members/{memberId} {
      allow read: if isAdmin() || isDocOwner(resource.data);
      allow create, update, delete: if isAdmin();
    }

    // Seetus collection
    match /seetus/{seetuId} {
      allow read: if isAdmin() || isDocOwner(resource.data);
      allow create, update, delete: if isAdmin();
    }

    // Payments collection
    match /payments/{paymentId} {
      allow read: if isAdmin() || isDocOwner(resource.data);
      allow create, update, delete: if isAdmin();
    }

    // Maturities collection
    match /maturities/{maturityId} {
      allow read: if isAdmin() || isDocOwner(resource.data);
      allow create, update, delete: if isAdmin();
    }

    // Settings collection
    match /settings/{settingsDocId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
